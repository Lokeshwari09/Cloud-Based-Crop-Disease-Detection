# Copy to .env and edit. Leave USE_S3=false to keep uploads on the local Docker volume.
USE_S3=false
S3_BUCKET=your-crop-disease-bucket
AWS_REGION=ap-south-1

# On EC2, attach an IAM role to the instance (no keys needed).
# Only for testing from your own laptop, uncomment and fill in:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
