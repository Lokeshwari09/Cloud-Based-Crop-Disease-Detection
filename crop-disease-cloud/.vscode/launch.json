{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Run web app (http://localhost:5000)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/app.py",
      "console": "integratedTerminal",
      "env": { "FLASK_DEBUG": "1" }
    },
    {
      "name": "2. Train model (+ save dataset images)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/train.py",
      "args": ["--save-dataset"],
      "console": "integratedTerminal"
    },
    {
      "name": "3. CloudSim-style simulation",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cloudsim_sim/simulation.py",
      "console": "integratedTerminal"
    },
    {
      "name": "4. Load test (server must be running)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/load_test.py",
      "args": ["--url", "http://localhost:5000", "--requests", "100", "--threads", "8"],
      "console": "integratedTerminal"
    },
    {
      "name": "5. Run unit tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"],
      "console": "integratedTerminal"
    }
  ]
}
